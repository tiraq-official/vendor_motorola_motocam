//
// Motorola camera stack for fogos (moto g34 5G) — full port
//
// Drop-in replacement for vendor/motorola/motocamera/Android.bp
//

// ---------------------------------------------------------------------------
// Main camera app  (com.motorola.camera3, MotCamera4.apk, v9.1.30.65)
//   - stored in Git LFS: run `git lfs pull` or this build ships a 134 byte file
// ---------------------------------------------------------------------------
android_app_import {
    name: "MotCamera4",
    owner: "motorola",
    apk: "proprietary/product/priv-app/MotCamera4/MotCamera4.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    product_specific: true,
    overrides: [
        "Aperture",
        "Camera2",
    ],
    required: [
        "MotCamera4.odex",
        "MotCamera4.vdex",
    ],
}

prebuilt_etc {
    name: "MotCamera4.odex",
    owner: "motorola",
    src: "proprietary/product/priv-app/MotCamera4/oat/arm64/MotCamera4.odex",
    sub_dir: "priv-app/MotCamera4/oat/arm64",
    product_specific: true,
    filename: "MotCamera4.odex",
}

prebuilt_etc {
    name: "MotCamera4.vdex",
    owner: "motorola",
    src: "proprietary/product/priv-app/MotCamera4/oat/arm64/MotCamera4.vdex",
    sub_dir: "priv-app/MotCamera4/oat/arm64",
    product_specific: true,
    filename: "MotCamera4.vdex",
}

// ---------------------------------------------------------------------------
// AI content plugin  (com.motorola.camera3.content.ai)
//   MotCamera4 requests com.motorola.camera3.content.ai.ACCESS from this app
// ---------------------------------------------------------------------------
android_app_import {
    name: "MotCamera3AI",
    owner: "motorola",
    apk: "proprietary/product/app/MotCamera3AI/MotCamera3AI.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
    required: [
        "MotCamera3AI.odex",
        "MotCamera3AI.vdex",
    ],
}

prebuilt_etc {
    name: "MotCamera3AI.odex",
    owner: "motorola",
    src: "proprietary/product/app/MotCamera3AI/oat/arm64/MotCamera3AI.odex",
    sub_dir: "app/MotCamera3AI/oat/arm64",
    product_specific: true,
    filename: "MotCamera3AI.odex",
}

prebuilt_etc {
    name: "MotCamera3AI.vdex",
    owner: "motorola",
    src: "proprietary/product/app/MotCamera3AI/oat/arm64/MotCamera3AI.vdex",
    sub_dir: "app/MotCamera3AI/oat/arm64",
    product_specific: true,
    filename: "MotCamera3AI.vdex",
}

// ---------------------------------------------------------------------------
// Moto signature verification framework
//   MotCamera4 declares <uses-library android:name="com.motorola.motosignature"
//   android:required="true"> — this is the ONLY hard library dependency of the
//   camera app, so it must always be present.
// ---------------------------------------------------------------------------
android_app_import {
    name: "MotoSignatureApp",
    owner: "motorola",
    apk: "proprietary/system/app/MotoSignatureApp/MotoSignatureApp.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
}

dex_import {
    name: "com.motorola.motosignature",
    owner: "motorola",
    jars: [
        "proprietary/system/framework/com.motorola.motosignature.jar",
    ],
}

dex_import {
    name: "moto-core_services",
    owner: "motorola",
    jars: [
        "proprietary/system/framework/moto-core_services.jar",
    ],
}

dex_import {
    name: "moto-settings",
    owner: "motorola",
    jars: [
        "proprietary/system/framework/moto-settings.jar",
    ],
}

// ---------------------------------------------------------------------------
// Moto settings provider  (com.motorola.android.providers.settings)
//   The stock APK runs with sharedUserId="android.uid.system", so it MUST be
//   signed with the ROM's platform key.  certificate:"platform" makes Soong
//   re-sign it — that is intentional and required.  Do not switch this to
//   presigned:true, the app will not be able to run as android.uid.system.
// ---------------------------------------------------------------------------
android_app_import {
    name: "MotorolaSettingsProvider",
    owner: "motorola",
    apk: "proprietary/system_ext/priv-app/MotorolaSettingsProvider/MotorolaSettingsProvider.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
    required: [
        "MotorolaSettingsProvider.odex",
        "MotorolaSettingsProvider.vdex",
    ],
}

prebuilt_etc {
    name: "MotorolaSettingsProvider.odex",
    owner: "motorola",
    src: "proprietary/system_ext/priv-app/MotorolaSettingsProvider/oat/arm64/MotorolaSettingsProvider.odex",
    sub_dir: "priv-app/MotorolaSettingsProvider/oat/arm64",
    system_ext_specific: true,
    filename: "MotorolaSettingsProvider.odex",
}

prebuilt_etc {
    name: "MotorolaSettingsProvider.vdex",
    owner: "motorola",
    src: "proprietary/system_ext/priv-app/MotorolaSettingsProvider/oat/arm64/MotorolaSettingsProvider.vdex",
    sub_dir: "priv-app/MotorolaSettingsProvider/oat/arm64",
    system_ext_specific: true,
    filename: "MotorolaSettingsProvider.vdex",
}

// ---------------------------------------------------------------------------
// motsettings command line tool
// ---------------------------------------------------------------------------
sh_binary {
    name: "motsettings",
    owner: "motorola",
    src: "proprietary/system_ext/bin/motsettings",
    filename: "motsettings",
    system_ext_specific: true,
}

// ---------------------------------------------------------------------------
// Motorola face detection / ANC libraries used by the camera HAL
// ---------------------------------------------------------------------------
cc_prebuilt_library_shared {
    name: "libAncFaceDetect",
    owner: "motorola",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/lib64/libAncFaceDetect.so",
            ],
            shared_libs: [
                "libancbase_fd",
                "libc",
                "libm",
                "libdl",
                "liblog",
            ],
        },
    },
    compile_multilib: "64",
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "libancbase_fd",
    owner: "motorola",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/lib64/libancbase_fd.so",
            ],
            shared_libs: [
                "libm",
                "liblog",
                "libdl",
                "libc",
            ],
        },
    },
    compile_multilib: "64",
    vendor: true,
}

// ---------------------------------------------------------------------------
// Imager tuning HAL services (only pulled in when MOTOCAMERA_IMAGERTUNING=true)
// ---------------------------------------------------------------------------
sh_binary {
    name: "motocamera_imgtuner_aidl_service",
    owner: "motorola",
    src: "proprietary/vendor/bin/hw/motorola.hardware.camera.imgtuner.aidl-service",
    filename: "motorola.hardware.camera.imgtuner.aidl-service",
    vendor: true,
    // installs to /vendor/etc/vintf/manifest/ and into the assembled device
    // manifest. PRODUCT_COPY_FILES rejects VINTF metadata outright.
    vintf_fragments: [
        "proprietary/vendor/etc/vintf/manifest/motorola.hardware.camera.imgtuner.aidl.xml",
    ],
}

sh_binary {
    name: "motocamera_imgtuner_hidl_service",
    owner: "motorola",
    src: "proprietary/vendor/bin/hw/motorola.hardware.camera.imgtuner@1.0-service",
    filename: "motorola.hardware.camera.imgtuner@1.0-service",
    vendor: true,
}

// ---------------------------------------------------------------------------
// Prebuilt Moto apps.
//
// These are presigned:true + preprocessed:true because their stock signatures
// matter (the camera checks them and Motorola apps share signature-level
// permissions).  All four pass Soong's preprocessed checks: every stored entry
// is 4-byte aligned, no .so is page-misaligned and no dex/lib is compressed.
// ---------------------------------------------------------------------------
android_app_import {
    name: "MotoSignature2App",
    owner: "motorola",
    apk: "proprietary/system/app/MotoSignature2App/MotoSignature2App.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "CameraExtensionsProxy",
    owner: "motorola",
    apk: "proprietary/system/app/CameraExtensionsProxy/CameraExtensionsProxy.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "MotCameraDesktop",
    owner: "motorola",
    apk: "proprietary/system_ext/priv-app/MotCameraDesktop/MotCameraDesktop.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

android_app_import {
    name: "ImagerTuning-V",
    owner: "motorola",
    apk: "proprietary/system_ext/priv-app/ImagerTuning-V/ImagerTuning-V.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

// ---------------------------------------------------------------------------
// Settings-provider resource overlays.
// android_app_import only writes to app/ or priv-app/, and an RRO there is never
// scanned, so they have to go through prebuilt_overlay -> <partition>/overlay.
// ---------------------------------------------------------------------------
prebuilt_overlay {
    name: "MotoSettingsProviderOverlayDPPCamera",
    owner: "motorola",
    src: "proprietary/product/overlay/MotoSettingsProviderOverlayDPPCamera.apk",
    filename: "MotoSettingsProviderOverlayDPPCamera.apk",
    product_specific: true,
}

prebuilt_overlay {
    name: "MotorolaSettingsProvider__fogos_g__auto_generated_rro_product",
    owner: "motorola",
    src: "proprietary/product/overlay/MotorolaSettingsProvider__fogos_g__auto_generated_rro_product.apk",
    filename: "MotorolaSettingsProvider__fogos_g__auto_generated_rro_product.apk",
    product_specific: true,
}

// ---------------------------------------------------------------------------
// Shared libraries the two Moto apps and the imgtuner HAL load.
// Names are prefixed because extract-utils already owns the natural names for
// the /vendor copies, so `stem` restores the exact on-device filename.
// ---------------------------------------------------------------------------
cc_prebuilt_library_shared {
    name: "motocamera_desktop_1_0",
    owner: "motorola",
    stem: "motorola.hardware.camera.desktop@1.0",
    srcs: [
        "proprietary/system_ext/lib64/motorola.hardware.camera.desktop@1.0.so",
    ],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "motocamera_desktop_2_0",
    owner: "motorola",
    stem: "motorola.hardware.camera.desktop@2.0",
    srcs: [
        "proprietary/system_ext/lib64/motorola.hardware.camera.desktop@2.0.so",
    ],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "motocamera_desktop_jni",
    owner: "motorola",
    stem: "libjni_helper.motocameradesktop",
    srcs: [
        "proprietary/system_ext/lib64/libjni_helper.motocameradesktop.so",
    ],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "motocamera_imgtuner_jni",
    owner: "motorola",
    stem: "libimgTuner_jni.motoimagetuner",
    srcs: [
        "proprietary/system_ext/lib64/libimgTuner_jni.motoimagetuner.so",
    ],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "motocamera_imgtuner_aidl",
    owner: "motorola",
    stem: "motorola.hardware.camera.imgtuner.aidl-V1-ndk",
    srcs: [
        "proprietary/system/lib64/motorola.hardware.camera.imgtuner.aidl-V1-ndk.so",
    ],
    compile_multilib: "64",
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "motocamera_imgtuner_1_0",
    owner: "motorola",
    stem: "motorola.hardware.camera.imgtuner@1.0",
    srcs: [
        "proprietary/vendor/lib64/motorola.hardware.camera.imgtuner@1.0.so",
    ],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "motocamera_imgtuner_aidl_platform",
    owner: "motorola",
    stem: "motorola.hardware.camera.imgtuner.aidl-V1-ndk_platform",
    srcs: [
        "proprietary/vendor/lib64/motorola.hardware.camera.imgtuner.aidl-V1-ndk_platform.so",
    ],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "motocamera_imgtuner_impl",
    owner: "motorola",
    stem: "motorola.hardware.camera.imgtuner@1.0-impl",
    srcs: [
        "proprietary/vendor/lib64/hw/motorola.hardware.camera.imgtuner@1.0-impl.so",
    ],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    vendor: true,
    relative_install_path: "hw",
}

