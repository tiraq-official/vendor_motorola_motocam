android_app_import {
    name: "MotoSignatureApp",
    owner: "motorola",
    apk: "proprietary/system/app/MotoSignatureApp/MotoSignatureApp.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "MotCamera3AI",
    owner: "motorola",
    apk: "proprietary/product/app/MotCamera3AI/MotCamera3AI.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
    required: [
        "MotCamera3AI.odex",
        "MotCamera3AI.vdex",
    ],
}

prebuilt_etc {
    name: "MotCamera3AI.odex",
    src: "proprietary/product/app/MotCamera3AI/oat/arm64/MotCamera3AI.odex",
    sub_dir: "app/MotCamera3AI/oat/arm64",
    product_specific: true,
    filename: "MotCamera3AI.odex",
}

prebuilt_etc {
    name: "MotCamera3AI.vdex",
    src: "proprietary/product/app/MotCamera3AI/oat/arm64/MotCamera3AI.vdex",
    sub_dir: "app/MotCamera3AI/oat/arm64",
    product_specific: true,
    filename: "MotCamera3AI.vdex",
}

android_app_import {
    name: "MotCamera4",
    owner: "motorola",
    apk: "proprietary/product/priv-app/MotCamera4/MotCamera4.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    product_specific: true,
    overrides: [
        "Aperture",
        "Camera2",
    ],
    required: [
        "MotCamera4.odex",
        "MotCamera4.vdex",
    ],
}

prebuilt_etc {
    name: "MotCamera4.odex",
    src: "proprietary/product/priv-app/MotCamera4/oat/arm64/MotCamera4.odex",
    sub_dir: "priv-app/MotCamera4/oat/arm64",
    product_specific: true,
    filename: "MotCamera4.odex",
}

prebuilt_etc {
    name: "MotCamera4.vdex",
    src: "proprietary/product/priv-app/MotCamera4/oat/arm64/MotCamera4.vdex",
    sub_dir: "priv-app/MotCamera4/oat/arm64",
    product_specific: true,
    filename: "MotCamera4.vdex",
}

android_app_import {
    name: "MotorolaSettingsProvider",
    owner: "motorola",
    apk: "proprietary/system_ext/priv-app/MotorolaSettingsProvider/MotorolaSettingsProvider.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
    required: [
        "MotorolaSettingsProvider.odex",
        "MotorolaSettingsProvider.vdex",
    ],
}

prebuilt_etc {
    name: "MotorolaSettingsProvider.odex",
    src: "proprietary/system_ext/priv-app/MotorolaSettingsProvider/oat/arm64/MotorolaSettingsProvider.odex",
    sub_dir: "priv-app/MotorolaSettingsProvider/oat/arm64",
    system_ext_specific: true,
    filename: "MotorolaSettingsProvider.odex",
}

prebuilt_etc {
    name: "MotorolaSettingsProvider.vdex",
    src: "proprietary/system_ext/priv-app/MotorolaSettingsProvider/oat/arm64/MotorolaSettingsProvider.vdex",
    sub_dir: "priv-app/MotorolaSettingsProvider/oat/arm64",
    system_ext_specific: true,
    filename: "MotorolaSettingsProvider.vdex",
}

dex_import {
    name: "com.motorola.motosignature",
    owner: "motorola",
    jars: [
        "proprietary/system/framework/com.motorola.motosignature.jar",
    ],
}

dex_import {
    name: "moto-core_services",
    owner: "motorola",
    jars: [
        "proprietary/system/framework/moto-core_services.jar",
    ],
}

dex_import {
    name: "moto-settings",
    owner: "motorola",
    jars: [
        "proprietary/system/framework/moto-settings.jar",
    ],
}

sh_binary {
    name: "motsettings",
    owner: "motorola",
    src: "proprietary/system_ext/bin/motsettings",
    filename: "motsettings",
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "libAncFaceDetect",
    owner: "motorola",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/lib64/libAncFaceDetect.so",
            ],
            shared_libs: [
                "libancbase_fd",
                "libc",
                "libm",
                "libdl",
                "liblog",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "libancbase_fd",
    owner: "motorola",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/lib64/libancbase_fd.so",
            ],
            shared_libs: [
                "libm",
                "liblog",
                "libdl",
                "libc",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    vendor: true,
}
